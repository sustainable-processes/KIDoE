    <!-- https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Concentration -->

    <owl:NamedIndividual rdf:about="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Concentration">
        <rdf:type rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#StateVariable"/>
        <hasDimension rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Species_Dimension"/>
        <hasDimension rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Stream_Dimension"/>
        <hasUnit rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#mol_per_L"/>
        <hasSymbol rdf:parseType="Literal"><math><mrow><mi>c</mi></mrow></math></hasSymbol>
    </owl:NamedIndividual>
    


    <!-- https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Concentration_Delta_Law_with_CSTR -->

    <owl:NamedIndividual rdf:about="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Concentration_Delta_Law_with_CSTR">
        <rdf:type rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Law"/>
        <hasModelVariable rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Flow_Rate"/>
        <hasModelVariable rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Initial_Concentration"/>
        <hasModelVariable rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Volume"/>
        <hasOptionalModelVariable rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Dispersion_Rate"/>
