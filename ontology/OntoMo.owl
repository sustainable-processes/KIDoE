    <!-- https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Activation_Energy -->

    <owl:NamedIndividual rdf:about="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Activation_Energy">
        <rdf:type rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#ReactionParameter"/>
        <hasDimension rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Reaction_Dimension"/>
        <hasDimension rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Stream_Dimension"/>
        <hasUnit rdf:resource="https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#kJ_per_mol"/>
        <hasSymbol rdf:parseType="Literal"><math><mrow><msub><mi>E</mi><mtext>a</mtext></msub></mrow></math></hasSymbol>
    </owl:NamedIndividual>
    


    <!-- https://github.com/zhangsy-ryan/KIDoE/main/ontology/OntoMo.owl#Arrhenius -->

